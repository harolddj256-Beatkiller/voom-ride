# Postgres connection string (Vercel Postgres, Neon, Supabase, etc.)
DATABASE_URL="postgresql://user:password@host:5432/voom?sslmode=require"

# Random string, at least 32 characters. Used to sign JWTs and as the OTP hash pepper.
JWT_SECRET="change-me-to-a-long-random-value"

# Chapa merchant account (https://dashboard.chapa.co) — required for online payments.
CHAPA_SECRET_KEY=""

# Public URL of this deployed backend, e.g. https://voom-api.vercel.app
# Used to build Chapa's callback/return URLs. Falls back to the request host if unset.
PUBLIC_BASE_URL=""

# Optional: Twilio account for sending real OTP SMS. Without these, OTP codes
# are only logged to the server console (non-production only).
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

NODE_ENV="development"

# Admin phone number(s), comma-separated, in +2519xxxxxxxx form. The account that
# signed up with this phone becomes the admin who approves drivers at /admin.
ADMIN_PHONES=""

# TESTING ONLY (no SMS service yet): these phones get no SMS; their code is TEST_OTP_CODE.
# Remove both before the public launch.
TEST_PHONES=""
TEST_OTP_CODE=""
