{
  "expo": {
    "name": "Beklo",
    "slug": "beklo",
    "version": "2.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "beklo",
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B2A5B"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Beklo uses your camera during driver sign-up to verify your identity with a selfie and a photo of your ID."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beklo.ride",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Beklo uses your location when you tap Use GPS to set your pickup point.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.beklo.ride",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B2A5B"
      }
    },
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "primaryColor": "#0B2A5B"
  }
}
