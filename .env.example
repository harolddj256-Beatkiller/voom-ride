# Required: URL of your deployed VOOM backend (see backend/README.md).
EXPO_PUBLIC_VOOM_API_URL=

# Optional Google Places/Routes integration — leave blank to use suggested places
# and straight-line distance estimates instead. Do not copy server secrets here.
EXPO_PUBLIC_MAPS_PROXY_URL=
EXPO_PUBLIC_MAPS_DEV_TOKEN=
EXPO_PUBLIC_USE_GOOGLE_MAPS=false
# Native SDK keys below are platform-restricted and compiled into native binaries.
# They MUST NOT be the Places / Routes server key.
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
